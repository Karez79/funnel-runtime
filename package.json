{
  "name": "funnel-runtime",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc -p . && pnpm -r --parallel typecheck",
    "lint:es": "eslint . --max-warnings 0",
    "lint:format": "prettier --check .",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .gitignore --allow-empty-input",
    "lint:deps": "depcruise packages apps --config .dependency-cruiser.cjs",
    "lint:dead": "knip",
    "lint:dup": "jscpd .",
    "lint": "pnpm lint:es && pnpm lint:format && pnpm lint:css && pnpm lint:deps && pnpm lint:dead && pnpm lint:dup",
    "test": "vitest run --coverage",
    "build": "pnpm -r --if-present build",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jscpd": "^5.3.3",
    "knip": "^6.39.0",
    "lefthook": "^2.1.15",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}

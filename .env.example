# Copy to .env for local overrides. In production all secrets are required.
PORT=3000
DATABASE_PATH=./data/funnel.db
# Admin Basic Auth for /admin, /api/admin/*, /api/analytics/*, /api/live
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Required header X-Generator-Key for trafficType=synthetic sessions
GENERATOR_KEY=change-me
# Optional: shown in /api/health; Railway sets RAILWAY_GIT_COMMIT_SHA automatically
# BUILD_VERSION=
# LOG_LEVEL=info

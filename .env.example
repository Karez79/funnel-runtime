# Copy to .env in the repo root for local runs (`pnpm dev` / `pnpm start` load it if present).
# Relative paths resolve from apps/server. In production all secrets are required.
PORT=3000
DATABASE_PATH=./data/funnel.db
# Built web app served by the same process (default ../web/dist, relative to apps/server)
WEB_DIST=../web/dist
# Admin Basic Auth for /admin, /api/admin/*, /api/analytics/*, /api/live
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Required header X-Generator-Key for trafficType=synthetic sessions
GENERATOR_KEY=change-me
# Optional: POST /api/sessions per minute per client IP (generator traffic is exempt)
# RATE_LIMIT_SESSIONS=30
# Header with the client IP set by the edge; production default x-real-ip (Railway), empty = socket address
# CLIENT_IP_HEADER=x-real-ip
# Optional: shown in /api/health; Railway sets RAILWAY_GIT_COMMIT_SHA automatically
# BUILD_VERSION=
# LOG_LEVEL=info
